(import ../deps/gum/test :prefix "")

(import ../lib/date)
(import ../lib/html)
(import ../lib/pages/file)

; HTML

(deftest escape
  (is (== "&lt;a href=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/a&gt;"
          (html/escape "<a href=\"x\">Tom & Jerry's</a>"))))

(deftest url-path
  (is (== "dir/file.txt" (html/url-path "dir/file.txt")))
  (is (== "sp%20ace/new%0Aline/uni-%C3%A9/%23%3F%25"
          (html/url-path "sp ace/new\nline/uni-é/#?%"))))

(deftest footer
  (def doc (html/document "Title" "" "<main>body</main>\n"))
  (is (string/find "<main>body</main>\n<footer>\n<hr>\n<p>Generated by" doc))
  (is (string/has-suffix? "</footer>\n</body>\n</html>\n" doc))
  (is (string/find "augite</a> at 2024-01-01 18:04 UTC</p>"
                   (html/document "Title" "" "" :generated 1704132245))))

(deftest file-root
  (is (== "../" (file/root "README.md")))
  (is (== "../../../" (file/root "a/b/c.txt"))))

; Dates

(deftest date-offset
  (is (== 32400 (date/offset "2024-01-02T03:04:05+09:00")))
  (is (== -16200 (date/offset "2024-01-02T03:04:05-04:30")))
  (is (== 0 (date/offset "2024-01-02T03:04:05Z"))))

(deftest date-formats
  (def t 1704132245)
  (is (== "2024-01-01 18:04" (date/short t)))
  (is (== "2024-01-01T18:04:05Z" (date/utc t)))
  (is (== "Tue,  2 Jan 2024 03:04:05 +0900" (date/long t "2024-01-02T03:04:05+09:00")))
  (is (== "Mon,  1 Jan 2024 13:34:05 -0430" (date/long t "2024-01-01T13:34:05-04:30")))
  (is (== "Mon,  1 Jan 2024 18:04:05 +0000" (date/long t "2024-01-01T18:04:05Z"))))

(run-tests!)
