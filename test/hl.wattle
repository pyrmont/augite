(import ../deps/gum/test :prefix "")

(import ../lib/highlight)
(import ../lib/hl/classes)
(import ../lib/hl/compile)
(import ../lib/hl/engine)
(import ../lib/hl/regex)

(defn- first-match
  """
  Returns the [start end] of the whole match and of each group of the first
  match of the regex source in text, with nil for a group that did not take
  part.
  """
  [source text]
  (def c (compile/compile source))
  (when-let [[_ groups] (compile/scan (compile/scanner [c]) text 0 -1 -1)]
    (vec (map #(get groups $) (range (inc (c :groups)))))))

; Regex parser

(deftest parse
  (is (== {:node [:seq [[:lit "a"]
                        [:rep 0 nil :lazy [:group 1 [:alt [[:lit "b"] [:lit "c"]]]]]
                        [:lit "d"]]]
           :groups 1
           :names {}}
          (regex/parse "a(b|c)*?d")))
  (is (== {:node [:seq [[:group 1 [:rep 0 1 :greedy [:lit "`"]]] [:backref "q"]]]
           :groups 1
           :names {"q" 1}}
          (regex/parse "(?x) (?<q>`?) # comment\n \\k<q>")))
  (is (== [:set [[0x2190 0x23FF]]] ((regex/parse "[\\x{2190}-\\x{23FF}]") :node)))
  (is (== [:lit "{}"] ((regex/parse "{}") :node))))

(deftest parse-errors
  (is (thrown? (regex/parse "(?m)a")))
  (is (thrown? (regex/parse "a\\K")))
  (is (thrown? (regex/parse "(a"))))

; Regex compiler

(deftest backtracking
  (is (== [[2 7] [5 6]] (first-match "a(b|c)*?d" "xxabcbd")))
  (is (== [[0 4] [1 3]] (first-match "a(b|bc)d" "abcd")))
  (is (== [[0 4] [0 1] [1 4] [4 4]] (first-match "(a|ab)(c|bcd)(d*)" "abcd")))
  (is (== [[0 5] [4 5]] (first-match ".*(x)" "abxcxd")))
  (is (== [[0 3] [2 3]] (first-match ".*?(x)" "abxcxd")))
  (is (== [[0 3]] (first-match "x{2,3}" "xxxx")))
  (is (== [[0 2]] (first-match "x{2,3}?" "xxxx"))))

(deftest atomic
  (is (nil? (first-match "(?>a*)a" "aaa")))
  (is (nil? (first-match "a*+a" "aaa"))))

(deftest anchors
  (is (== [[6 10]] (first-match "\\bfunc\\b" "funcs func")))
  (is (== [[0 5] [2 3] [3 5]] (first-match "^\\s*(#)(if)" "  #if X")))
  (is (== [[3 3]] (first-match "$" "abc\n")))
  (def c (compile/compile "\\Gx"))
  (def s (compile/scanner [c]))
  (is (nil? (compile/scan s "axx" 1 -1 -1)))
  (is (== [0 {0 [1 2]}] (compile/scan s "axx" 1 1 -1))))

(deftest lookaround
  (is (== [[4 7]] (first-match "(?<=\\.)foo" "foo.foo")))
  (is (== [[5 8]] (first-match "(?<!\\.)foo" ".foo foo")))
  (is (== [[0 1] [0 3]] (first-match "(?=(foo))f" "foo")))
  (is (== [[2 4] [3 4]] (first-match "(?<=[`\\p{L}_])\\s*(\\[)" "é [")))
  (is (== [[10 11]] (first-match "(?<![a-zé]\\.)x" "é.x a.x .x"))))

(deftest backreferences
  (is (== [[0 9] [0 2] [3 6]] (first-match "(\\#+)/(.*?)/\\1" "##/x/#/##")))
  (is (== [[4 10] [4 5] [9 10]] (first-match "(?<q>`?)[\\p{L}_][\\p{L}_]*(\\k<q>)" "  = `déf`"))))

(deftest calls
  (is (== [[0 2] [1 2]] (first-match "(\\()(?:x|\\g<1>)" "((x")))
  (is (== [[0 8] [0 8]] (first-match "(\\{(?:\\g<-1>|(?!{).*?)\\})" "{{a} b}}X"))))

(deftest ignore-case
  (is (== [[0 8]] (first-match "<(?i:script)>" "<ScRiPt>x")))
  (is (== [[2 5]] (first-match "(?i)[a-c]+" "xxAbC")))
  (is (nil? (first-match "(?i)[^a]" "A"))))

(deftest variable-lookbehind
  (is (nil? (first-match "(?<!(?:^|\\s)await\\s+)using" "await   using")))
  (is (nil? (first-match "(?<!(?:^|\\s)await\\s+)using" "x await using")))
  (is (== [[8 13]] (first-match "(?<!(?:^|\\s)await\\s+)using" "xawait  using")))
  (is (== [[1 2] [1 2]] (first-match "(a)(?<=\\1)" "baa")))
  (is (thrown? (compile/compile "(a)(?<=b\\1)"))))

(deftest empty-iterations
  (is (== [[0 3]] (first-match "(?:a*)*b" "aab")))
  (is (== [[0 0]] (first-match "(?:x?)*" "yy"))))

(deftest unicode
  (is (== [[1 7]] (first-match "[\\x{2190}-\\x{23FF}]+" "a→↓b")))
  (is (== [[0 2]] (first-match "." "é"))))

; Classes

(deftest class-of
  (is (== "hl-keyword" (classes/class-of ["source.swift" "keyword.control.swift"])))
  (is (== "hl-string" (classes/class-of ["source.swift" "string.quoted.double.swift"
                                         "punctuation.definition.string.begin.swift"])))
  (is (nil? (classes/class-of ["source.swift" "string.quoted.double.swift"
                               "meta.embedded.line.swift"])))
  (is (nil? (classes/class-of ["source.swift" "keywords.swift"])))
  (is (== "hl-property" (classes/class-of ["source.json" "string.json" "support.type.property-name.json"
                                           "punctuation.support.type.property-name.begin.json"])))
  (is (== "hl-tag" (classes/class-of ["source.yaml" "string.unquoted.plain.out.yaml"
                                      "entity.name.tag.yaml"]))))

; Highlighting

(def- grammars (highlight/load-grammars "res/grammars"))

(deftest highlight
  (is (nil? (highlight/highlight grammars "README.md" "# Title\n")))
  (is (== ["<span class=\"hl-keyword\">let</span> x <span class=\"hl-keyword\">=</span> <span class=\"hl-number\">1</span>"
           "<span class=\"hl-comment\">// &lt;b&gt;</span>"]
          (highlight/highlight grammars "a/b.swift" "let x = 1\n// <b>\n"))))

(defn- join-tokens
  "Joins the adjacent tokens in line that have the same scopes."
  [line]
  (def out ![])
  (each [s e scopes] line
    (def prev (array/peek out))
    (if (and prev (= (get prev 1) s) (= (get prev 2) scopes))
      (put! out (dec (length out)) [(get prev 0) e scopes])
      (array/push! out [s e scopes])))
  (vec out))

(deftest conformance
  ; The tokens of vscode-textmate, from res/tools/tokens.mjs.
  (def fixture (json/decode (slurp "test/hl/grammar-test.swift.json")))
  (def scopes (fixture "scopes"))
  (def expected (map (fn [line] (vec (map (fn [[s e i]] [s e (get scopes i)]) line)))
                     (fixture "lines")))
  (def actual (engine/tokenize (highlight/grammar-for grammars "x.swift")
                                 (slurp "test/hl/grammar-test.swift")))
  (is (== (length expected) (length actual)))
  (def differ (filter (fn [i]
                        (not= (join-tokens (map (fn [[s e sc]] [s e (string/join " " sc)])
                                                (get actual i)))
                              (get expected i)))
                      (range (length expected))))
  (is (== [] (vec (map inc differ)))))

(run-tests!)
