(import ../deps/gum/test :prefix "")

(import ../lib/highlight)
(import ../lib/hl/classes)
(import ../lib/hl/engine)

(import onig)

; Scanners

(defn- scan [patterns text pos]
  (onig/scan (onig/scanner patterns) text pos))

(deftest scanner
  ; The match that starts earliest wins, and the earlier regex a tie.
  (is (== [1 [[1 2]]] (scan ["c" "b" "bc"] "abc" 0)))
  (is (== [1 [[1 2]]] (scan ["x" "b|bc" "bc"] "abc" 0)))
  (is (nil? (scan ["x"] "abc" 0)))
  ; A group that does not take part is nil. Positions are in bytes.
  (is (== [0 [[1 4] nil [3 4] nil]] (scan ["é(x)?(b)|é(b)" "z"] "aébcb" 0)))
  ; Named groups are numbered with the others.
  (is (== [0 [[1 4] [2 3] [3 4]]] (scan ["a(?<n>b)(\\k<n>)"] "xabb" 0)))
  ; \\G matches where the search starts.
  (is (nil? (scan ["\\Gb"] "abb" 0)))
  (is (== [0 [[1 2]]] (scan ["\\Gb"] "abb" 1))))

(deftest scanner-reuses-results
  ; A later search of the same text gives the same results as a new scanner.
  (def s (onig/scanner ["(?<=b)c+" "a(x)?(b)" "\\Gc" "\\p{Greek}+"]))
  (def text "abccc λλ")
  (each pos [0 2 3 5 6 9]
    (is (== (scan ["(?<=b)c+" "a(x)?(b)" "\\Gc" "\\p{Greek}+"] text pos)
            (onig/scan s text pos))
        (string pos))))

(deftest scanner-errors
  ; A regex that does not compile never matches.
  (is (== "end pattern with unmatched parenthesis" (onig/error "(a")))
  (is (nil? (onig/error "a(?<n>b)\\k<n>")))
  (is (== [1 [[0 1]]] (scan ["(a" "a"] "a" 0))))

; Classes

(deftest class-of
  (is (== "hl-keyword" (classes/class-of ["source.swift" "keyword.control.swift"])))
  (is (== "hl-string" (classes/class-of ["source.swift" "string.quoted.double.swift"
                                         "punctuation.definition.string.begin.swift"])))
  (is (nil? (classes/class-of ["source.swift" "string.quoted.double.swift"
                               "meta.embedded.line.swift"])))
  (is (nil? (classes/class-of ["source.swift" "keywords.swift"])))
  (is (== "hl-property" (classes/class-of ["source.json" "string.json" "support.type.property-name.json"
                                           "punctuation.support.type.property-name.begin.json"])))
  (is (== "hl-tag" (classes/class-of ["source.yaml" "string.unquoted.plain.out.yaml"
                                      "entity.name.tag.yaml"]))))

; Highlighting

(def- grammars
  [(engine/load {"scopeName" "source.test" "fileTypes" ["test"]
                 "patterns" [{"match" "\\blet\\b" "name" "keyword.test"}
                             {"match" "\\d+" "name" "constant.numeric.test"}
                             {"match" "//.*" "name" "comment.line.test"}]})])

(deftest highlight
  (is (nil? (highlight/highlight grammars "README.md" "# Title\n")))
  (is (== ["<span class=\"hl-keyword\">let</span> x = <span class=\"hl-number\">1</span>"
           "<span class=\"hl-comment\">// &lt;b&gt;</span>"]
          (highlight/highlight grammars "a/b.test" "let x = 1\n// <b>\n"))))

(run-tests!)
