(import ../deps/gum/test :prefix "")
(import ./support/fixture)

; Helpers

; The tests run the program with the Wattle interpreter that is running them,
; with the module path of the tests, so that the program finds onig.
(def- program [(dyn :executable)
               "-e" (string/format "(setdyn *modpath* %q)" (dyn *modpath*))
               "lib/cli.wattle"])

(defn- shell-capture [args]
  (def x (os/spawn (array/concat! ![] program args) :p {:out :pipe :err :pipe}))
  (def o (:read (x :out) :all))
  (def e (:read (x :err) :all))
  (:wait x)
  [(get x :return-code) o e])

; Tests

(deftest cli-no-args
  (def [exit-code test-out test-err] (shell-capture []))
  (is (== 1 exit-code))
  (is (== nil test-out))
  (is (== "augite: no subcommand provided\nTry 'augite --help' for more information.\n"
          test-err)))

(deftest cli-help
  (def [exit-code test-out test-err] (shell-capture ["--help"]))
  (is (== 0 exit-code))
  (is (string/has-prefix? "Usage: augite <subcommand>" test-out))
  (is (== nil test-err)))

(deftest cli-repo-help
  (def [exit-code test-out test-err] (shell-capture ["repo" "--help"]))
  (is (== 0 exit-code))
  (is (string/has-prefix? "Usage: augite repo " test-out))
  (is (== nil test-err)))

(deftest cli-index-help
  (def [exit-code test-out test-err] (shell-capture ["help" "index"]))
  (is (== 0 exit-code))
  (is (string/has-prefix? "Usage: augite index " test-out))
  (is (== nil test-err)))

(deftest cli-repo-missing-dir
  (def [exit-code test-out test-err] (shell-capture ["repo"]))
  (is (== 1 exit-code))
  (is (== nil test-out))
  (is (string/has-prefix? "augite repo: repo-dir is required\n" test-err)))

(deftest cli-repo-bad-per-page
  (def [exit-code test-out test-err] (shell-capture ["repo" "-p" "x" "."]))
  (is (== 1 exit-code))
  (is (== nil test-out))
  (is (string/has-prefix? "augite repo: 'x' is invalid value for -p\n" test-err)))

(deftest cli-repo-not-a-directory
  (def [exit-code test-out test-err] (shell-capture ["repo" "test/missing"]))
  (is (== 1 exit-code))
  (is (== nil test-out))
  (is (== "augite: not a directory: test/missing\n" test-err)))

(deftest cli-setup
  (def repo "tmp/cli/setup.git")
  (fixture/rmrf "tmp/cli")
  (fixture/mkdirp repo)
  (fixture/git repo "2024-01-01T00:00:00Z" "init" "-q" "--bare")
  (def [exit-code test-out test-err]
    (shell-capture ["setup" "-d" "A repository" "-o" "Ada" "-u" "https://example.org/x.git" repo]))
  (is (== 0 exit-code))
  (is (== nil test-out))
  (is (== nil test-err))
  (def [exit-code test-out test-err] (shell-capture ["setup" "--url" "" repo]))
  (is (== 0 exit-code))
  (def [exit-code test-out test-err] (shell-capture ["setup" repo]))
  (is (== 0 exit-code))
  (is (== "description: A repository\nowner: Ada\nurl: \n" (string test-out)))
  (is (== nil test-err)))

(deftest cli-unknown-subcommand
  (def [exit-code test-out test-err] (shell-capture ["bogus"]))
  (is (== 1 exit-code))
  (is (== nil test-out))
  (is (string/has-prefix? "augite: unrecognized subcommand 'bogus'\n" test-err)))

(run-tests!)
