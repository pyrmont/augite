(import ./assets)
(import ./date)

(defn escape
  "Escapes the characters in s that are special in HTML and XML."
  [s]
  (->> (string s)
       (string/replace-all "&" "&amp;")
       (string/replace-all "<" "&lt;")
       (string/replace-all ">" "&gt;")
       (string/replace-all "\"" "&quot;")
       (string/replace-all "'" "&#39;")))

(def- unreserved
  (string "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
          "0123456789-._~/"))

(defn url-path
  """
  Percent-encodes the bytes of the path s that cannot appear in a URL path,
  leaving `/` as it is.
  """
  [s]
  (if (string/check-set unreserved s)
    s
    (do
      (def out !"")
      (each b s
        (if (string/check-set unreserved (string/from-bytes b))
          (buffer/push-byte! out b)
          (buffer/format! out "%%%02X" b)))
      (string out))))

(defn file-href
  "Returns the link from root to the page for the file at path."
  [root path]
  (string root "file/" (url-path path) ".html"))

(defn commit-href
  "Returns the link from root to the page for the commit hash."
  [root hash]
  (string root "commit/" hash ".html"))

(defn- nav-html [root nav current]
  (string/join
    " | "
    (map (fn [[key text href]]
           (string "<a href=\"" root href "\""
                   (if (and current (= key current)) " aria-current=\"page\"" "")
                   ">" (escape text) "</a>"))
         nav)))

(defn- footer
  "Returns the footer, which gives the Unix time generated, if not nil."
  [generated]
  (string "<footer>\n"
          "<hr>\n"
          "<p>Generated by <a href=\"https://github.com/pyrmont/augite\">augite</a>"
          (if generated (string " at " (date/short generated) " UTC") "")
          "</p>\n"
          "</footer>\n"))

(defn document
  """
  Returns an HTML document with title. head is the markup added to the head
  after the title, and body the markup of the body, which the footer
  follows. With generated, a Unix time, the footer says when the page was
  generated.
  """
  [title head body & {:keys [generated]}]
  (string "<!DOCTYPE html>\n"
          "<html lang=\"en\">\n"
          "<head>\n"
          "<meta charset=\"utf-8\">\n"
          "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
          "<meta name=\"color-scheme\" content=\"light dark\">\n"
          "<title>" (escape title) "</title>\n"
          head
          "</head>\n"
          "<body>\n"
          body
          (footer generated)
          "</body>\n"
          "</html>\n"))

(defn page
  """
  Returns an HTML page for the repository described by ctx. root is the
  relative path from the page to the top of the repository's site, title is
  the title of the page, current is the key of the navigation item to mark
  as current, if any, and body is the content of the page.
  """
  [ctx root title current body]
  (def info (ctx :info))
  (def name (escape (info :name)))
  (def desc (info :description))
  (def head
    (string "<link rel=\"icon\" type=\"image/png\" href=\"" root "favicon.png\">\n"
            "<link rel=\"alternate\" type=\"application/atom+xml\" title=\"" name
            " Atom Feed\" href=\"" root "atom.xml\">\n"
            "<link rel=\"alternate\" type=\"application/atom+xml\" title=\"" name
            " Atom Feed (tags)\" href=\"" root "tags.xml\">\n"
            "<link rel=\"stylesheet\" href=\"" root assets/style-href "\">\n"
            "<script src=\"" root assets/script-href "\" defer></script>\n"))
  (def logo (string "<img src=\"" root "logo.png\" alt=\"\" width=\"32\" height=\"32\">"))
  (def out !"")
  (if-let [parent (ctx :parent)]
    (let [href (escape (if (or (string/has-prefix? "/" parent) (string/find "://" parent))
                         parent
                         (string root parent)))]
      (buffer/push!
        out
        "<p class=\"up\"><a href=\"" href "\">← All repositories</a></p>\n"
        "<header>\n"
        "<a href=\"" href "\">" logo "</a>\n"))
    (buffer/push! out "<header>\n" logo "\n"))
  (buffer/push! out "<div>\n" "<h1>" name "</h1>\n")
  (when desc
    (buffer/push! out "<p class=\"desc\">" (escape desc) "</p>\n"))
  (when-let [url (info :url)]
    (buffer/push! out "<p class=\"url\"><span class=\"command\">git clone <a href=\""
                  (escape url) "\">" (escape url) "</a></span></p>\n"))
  (buffer/push!
    out
    "</div>\n"
    "<nav>" (nav-html root (ctx :nav) current) "</nav>\n"
    "</header>\n"
    "<hr>\n"
    "<main id=\"content\">\n"
    body
    "</main>\n")
  (document (string title " - " (info :name) (if desc (string " - " desc) ""))
            head (string out)
            :generated (ctx :generated)))
