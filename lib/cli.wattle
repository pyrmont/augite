(import ../deps/gum/args)
(import ./site)

(def- repo-config
  {:help "Generate pages for a repository."
   :rules [:repo-dir     {:help  "The path of the Git repository."
                          :proxy "repo-dir"
                          :req?  true}
           "--output"    {:help    "The directory to write the site into."
                          :default "."
                          :kind    :single
                          :proxy   "dir"
                          :short   "o"}
           "--grammars"  {:help  "The directory of TextMate grammars."
                          :kind  :single
                          :proxy "dir"
                          :short "g"}
           "--cache"     {:help  (string "The directory in which to keep highlighted files "
                                         "between runs.")
                          :kind  :single
                          :proxy "dir"
                          :short "c"}
           "--per-page"  {:help    "The number of commits per log page."
                          :default 50
                          :kind    :single
                          :proxy   "n"
                          :short   "p"
                          :value   :integer}
           "--base-url"  {:help  (string "The URL of the site, used to make the links in "
                                         "the Atom feeds absolute.")
                          :kind  :single
                          :proxy "url"
                          :short "u"}
           "--parent"    {:help  (string "The path or URL of the list of repositories to "
                                         "link each page to. A relative path is relative "
                                         "to the site, as in `..`.")
                          :kind  :single
                          :proxy "path"}
           "-------------------------------------------"]})

(def- index-config
  {:help "Generate the list of repositories."
   :rules [:repo-dirs {:help   "The paths of the Git repositories."
                       :proxy  "repo-dir"
                       :req?   true
                       :splat? true}
           "--output" {:help    "The directory to write the index into."
                       :default "."
                       :kind    :single
                       :proxy   "dir"
                       :short   "o"}
           "-------------------------------------------"]})

(def- setup-config
  {:help "Set or show the description, owner and clone URL for a repository."
   :rules [:repo-dir       {:help  "The path of the Git repository."
                            :proxy "repo-dir"
                            :req?  true}
           "--description" {:help  "The one-line description. An empty value removes it."
                            :kind  :single
                            :proxy "text"
                            :short "d"}
           "--owner"       {:help  "The owner. An empty value removes it."
                            :kind  :single
                            :proxy "name"
                            :short "o"}
           "--url"         {:help  "The URL to clone from. An empty value removes it."
                            :kind  :single
                            :proxy "url"
                            :short "u"}
           "-------------------------------------------"]})

(def- setup-fields ["description" "owner" "url"])

(def config
  "The configuration for Argy-Bargy"
  {:subs ["repo"  repo-config
          "index" index-config
          "setup" setup-config]
   :info {:about "Generate a static site for one or more Git repositories."}})

(defn run [args]
  (def parsed (args/parse-args "augite" config args))
  (def err (parsed :err))
  (def help (parsed :help))
  (cond
    (not (empty? help))
    (do
      (prin help)
      (os/exit (if (or (get-in parsed [:opts "help"])
                       (get-in parsed [:sub :opts "help"]))
                 0 1)))
    (not (empty? err))
    (do
      (eprin err)
      (os/exit 1))
    (do
      (def sub (parsed :sub))
      (def opts (sub :opts))
      (def params (sub :params))
      (try
        (case (sub :cmd)
          "index"
          (site/write-index (params :repo-dirs)
                            :output (opts "output"))
          "repo"
          (site/write-repo (params :repo-dir)
                           :output (opts "output")
                           :grammars (opts "grammars")
                           :cache (opts "cache")
                           :per-page (opts "per-page")
                           :base-url (opts "base-url")
                           :parent (opts "parent"))
          "setup"
          (site/setup (params :repo-dir)
                      (from-pairs (keep #(when-let [v (opts $)] [(keyword $) v])
                                        setup-fields))))
        ([e]
          (eprint "augite: " e)
          (os/exit 1))))))

(defn main [script & args] (run args))
