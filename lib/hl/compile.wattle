; Compiles the AST of a regex to a PEG.
;
; The translation is the continuation method of Medeiros, Mascarenhas and
; Ierusalimschy ("From Regexps to Parsing Expression Grammars"): each node is
; compiled together with the PEG for what follows it, so that a PEG ordered
; choice backtracks as a regex alternation does. A continuation used in more
; than one place becomes a named rule, so that it is shared, not copied.
;
; A compiled regex is a grammar whose main rule captures the bytes it matched
; as markers: (constant n) (position) where capture group n opens and
; (constant -n) (position) where it closes, followed by the (position) where
; the match ends. Any other capture is a string and is ignored. A group that a
; backreference names is also captured as text with the tag :tN, for
; backmatch.
;
; The PEG takes three extra arguments: the position at which \G matches, the
; position at which \A matches (-1 for neither), and the text, for
; backreferences.

(import ./regex)

; Byte sets, for the bytes a continuation can start with. A set is a table of
; bytes, with 256 for the end of the text; nil means any byte; and :accept
; means the continuation matches anywhere.

(def- end-byte 256)

(defn- union [a b]
  (cond
    (or (= :accept a) (= :accept b)) :accept
    (or (nil? a) (nil? b)) nil
    (merge a b)))

(defn- lead-bytes
  "Returns a byte set of the first bytes of the UTF-8 encodings in ranges."
  [ranges]
  (def out !{})
  (each [lo hi] ranges
    (if (< hi 0x80)
      (for b lo (inc hi) (put! out b true))
      (do
        (for b lo (min 0x80 (inc hi)) (put! out b true))
        (for b (get (regex/utf8 (max lo 0x80)) 0) (inc (get (regex/utf8 hi) 0))
          (put! out b true)))))
  out)

(defn- transparent [s]
  (if (= :accept s) nil s))

(defn- memo [f]
  (var done false)
  (var value nil)
  (fn []
    (unless done
      (set value (f))
      (set done true))
    value))

(defn- first-of
  """
  Returns the byte set of node followed by a continuation whose byte set is
  returned by the function k-first.
  """
  [node k-first]
  (def k-first (memo k-first))
  (case (first node)
    :lit (if (empty? (get node 1)) (k-first) {(get (get node 1) 0) true})
    :set (lead-bytes (get node 1))
    :seq (do
           (var f k-first)
           (each n (reverse (get node 1))
             (def next f)
             (set f (fn [] (first-of n next))))
           (f))
    :alt (reduce (fn [acc n] (union acc (first-of n k-first)))
                 {} (get node 1))
    :group (first-of (get node 2) k-first)
    :atomic (first-of (get node 1) k-first)
    ; A match after a lookahead starts where the lookahead matches.
    :look (let [ahead (when (and (= :ahead (get node 1)) (not (get node 2)))
                        (first-of (get node 3) (fn [] :accept)))]
            (if (dictionary? ahead) ahead (transparent (k-first))))
    :rep (if (zero? (get node 1))
           (union (first-of (get node 4) k-first) (k-first))
           (first-of (get node 4) k-first))
    :assert (case (get node 1)
              :eol {10 true end-byte true}
              :Z {10 true end-byte true}
              :z {end-byte true}
              (transparent (k-first)))
    nil))

(defn- disjoint?
  "Returns true if no code point in ranges can start a match of the byte set s."
  [ranges s]
  (cond
    (= :accept s) true
    (nil? s) false
    (do
      (def leads (lead-bytes ranges))
      (nil? (find-index #(has-key? s $) (keys leads))))))

; Sets of code points as PEGs

(defn- utf8-ranges
  """
  Returns the byte ranges that match the UTF-8 encodings of the code points
  from lo to hi, which must encode to the same number of bytes, as a vector of
  sequences of [lo hi] byte pairs.
  """
  [lo hi]
  (def n (length (regex/utf8 lo)))
  (var split nil)
  (for i 1 n
    (unless split
      (def m (dec (blshift 1 (* 6 i))))
      (when (not= (band lo (bnot m)) (band hi (bnot m)))
        (cond
          (not= 0 (band lo m)) (set split [lo (bor lo m)])
          (not= m (band hi m)) (set split [lo (dec (band hi (bnot m)))])))))
  (if split
    [|(utf8-ranges (get split 0) (get split 1))
     |(utf8-ranges (inc (get split 1)) hi)]
    (do
      (def a (regex/utf8 lo))
      (def b (regex/utf8 hi))
      [(vec (map (fn [i] [(get a i) (get b i)]) (range n)))])))

(defn- byte-range [lo hi]
  (if (= lo hi)
    (string/from-bytes lo)
    ['range (string/from-bytes lo hi)]))

(defn- non-ascii-peg
  "Returns the PEG for the code points in ranges, which are all non-ASCII."
  [ranges]
  (if (= ranges [[0x80 regex/max-cp]])
    ; Every non-ASCII code point, read leniently.
    ['* ['range "\xC0\xFF"] ['any ['range "\x80\xBF"]]]
    (do
      (def seqs ![])
      (each [lo hi] ranges
        (each [a b] [[0x80 0x7FF] [0x800 0xFFFF] [0x10000 regex/max-cp]]
          (when (and (<= lo b) (>= hi a))
            (each s (utf8-ranges (max lo a) (min hi b))
              (array/push! seqs ['* |(map (fn [[x y]] (byte-range x y)) s)])))))
      (if (= 1 (length seqs)) (first seqs) ['+ |seqs]))))

(defn set-peg
  "Returns the PEG that matches one code point in ranges."
  [ranges]
  (def ascii !"")
  (def wide ![])
  (each [lo hi] ranges
    (for b lo (inc (min hi 0x7F))
      (buffer/push-byte! ascii b))
    (when (> hi 0x7F)
      (array/push! wide [(max lo 0x80) hi])))
  (def parts ![])
  (case (length ascii)
    0 nil
    1 (array/push! parts (string ascii))
    (array/push! parts ['set (string ascii)]))
  (unless (empty? wide)
    (array/push! parts (non-ascii-peg (vec wide))))
  (case (length parts)
    0 ['not 0]
    1 (first parts)
    ['+ |parts]))

; Lengths, for lookbehind

(defn- fixed-length
  "Returns the number of bytes node always matches, or nil if it varies."
  [node]
  (case (first node)
    :lit (length (get node 1))
    :set (do
           (def lens (distinct (mapcat (fn [[lo hi]] [(length (regex/utf8 lo))
                                                      (length (regex/utf8 hi))])
                                       (get node 1))))
           (when (= 1 (length lens)) (first lens)))
    :seq (do
           (var total 0)
           (each n (get node 1)
             (def len (fixed-length n))
             (set total (when (and total len) (+ total len))))
           total)
    :alt (do
           (def lens (distinct (map fixed-length (get node 1))))
           (when (and (= 1 (length lens)) (first lens)) (first lens)))
    :group (fixed-length (get node 2))
    :atomic (fixed-length (get node 1))
    :look 0
    :assert 0
    :rep (when (= (get node 1) (get node 2))
           (when-let [len (fixed-length (get node 4))]
             (* len (get node 1))))
    nil))

(defn- group-number [c ref]
  (if (number? ref)
    ref
    (or (get (c :names) ref)
        (errorf "unknown group name: %s" ref))))

(def- max-variants 64)

(defn- variants
  """
  Returns a vector of nodes that together match what node matches, each of
  which matches a fixed number of bytes, or nil if there are none. A set is
  split by the length of its code points' encodings.
  """
  [node]
  (def out
    (case (first node)
      :lit [node]
      :set (do
             (def parts ![])
             (each [a b] [[0 0x7F] [0x80 0x7FF] [0x800 0xFFFF] [0x10000 regex/max-cp]]
               (def sub (keep (fn [[lo hi]] (when (and (<= lo b) (>= hi a))
                                              [(max lo a) (min hi b)]))
                              (get node 1)))
               (unless (empty? sub)
                 (array/push! parts [:set (vec sub)])))
             (vec parts))
      :seq (do
             (var acc [[]])
             (each n (get node 1)
               (def vs (variants n))
               (set acc (when (and acc vs)
                          (vec (mapcat (fn [prefix] (map #(conj prefix $) vs)) acc))))
               (when (and acc (> (length acc) max-variants))
                 (set acc nil)))
             (when acc (vec (map #(vector :seq $) acc))))
      :alt (do
             (def vs (map variants (get node 1)))
             (unless (find-index nil? vs) (vec (mapcat identity vs))))
      :group (when-let [vs (variants (get node 2))]
               (vec (map #(vector :group (get node 1) $) vs)))
      :atomic (when-let [vs (variants (get node 1))]
                (vec (map #(vector :atomic $) vs)))
      :look [node]
      :assert [node]
      :rep (when (= (get node 1) (get node 2))
             (variants [:seq (vec (map (fn [_] (get node 4)) (range (get node 1))))]))
      nil))
  (when (and out (<= (length out) max-variants)) out))

(defn- nullable?
  "Returns true if node, compiled with c, can match the empty string."
  [c node]
  (case (first node)
    :lit (empty? (get node 1))
    :set false
    :seq (every? (map #(nullable? c $) (get node 1)))
    :alt (any? (map #(nullable? c $) (get node 1)))
    :group (nullable? c (get node 2))
    :atomic (nullable? c (get node 1))
    :rep (or (zero? (get node 1)) (nullable? c (get node 4)))
    ; A group that calls itself is not followed, and is taken to consume.
    :call (do
            (def n (group-number c (get node 1)))
            (if (get (c :visiting) n)
              false
              (do
                (put! (c :visiting) n true)
                (def result (nullable? c (or (get (c :groups) n) [:lit ""])))
                (put! (c :visiting) n nil)
                result)))
    true))

; Assertions

(def- word-byte ['range "az" "AZ" "09" "__" "\x80\xFF"])

(def- word-boundary
  ['+ ['* ['look -1 word-byte] ['not word-byte]]
      ['* ['not ['look -1 word-byte]] ['look 0 word-byte]]])

(defn- at-argument [n]
  ['drop ['cmt ['* ['position] ['argument n]] =]])

(def- assertions
  {:bol ['+ ['not ['look -1 1]] ['look -1 "\n"]]
   :eol ['+ ['look 0 "\n"] ['not 1]]
   :word word-boundary
   :non-word ['not word-boundary]
   :G (at-argument 0)
   :A (at-argument 1)
   :z ['not 1]
   :Z ['+ ['not 1] ['look 0 ['* "\n" ['not 1]]]]})

; The compiler

(def- eps {:peg 0 :first (fn [] :accept)})

(defn- then
  "Returns the PEG that matches a and then b."
  [a b]
  (cond
    (= 0 b) a
    (= 0 a) b
    (and (indexed? b) (= '* (first b)))
    (if (and (indexed? a) (= '* (first a)))
      ['* |(slice a 1) |(slice b 1)]
      ['* a |(slice b 1)])
    (and (indexed? a) (= '* (first a)))
    ['* |(slice a 1) b]
    ['* a b]))

(defn- rule
  "Adds a rule with the PEG peg to the grammar of c and returns its name."
  [c peg]
  (def name (keyword "r" (length (c :rules))))
  (put! (c :rules) name peg)
  name)

(defn- share
  "Returns k with its PEG made a rule, if it is more than a name or a literal."
  [c k]
  (def peg (k :peg))
  (if (or (keyword? peg) (string? peg) (number? peg))
    k
    {:peg (rule c peg) :first (k :first)}))

(defn- single-set
  "Returns the ranges of node if it matches exactly one code point, else nil."
  [node]
  (case (first node)
    :set (get node 1)
    :lit (when (and (= 1 (length (get node 1))) (< (get (get node 1) 0) 0x80))
           [[(get (get node 1) 0) (get (get node 1) 0)]])
    nil))

(var- compile-node nil)

(defn- continue
  "Returns the continuation that matches node and then k."
  [c node k]
  {:peg (compile-node c node k)
   :first (memo (fn [] (first-of node (k :first))))})

(defn- compile-star
  """
  Compiles node repeated any number of times, followed by k. Returns a map of
  :peg and, if node was compiled as a rule followed by the repetition,
  :body, the name of that rule.
  """
  [c node mode k]
  (def ranges (single-set node))
  (cond
    (and ranges (= :greedy mode) (disjoint? ranges ((k :first))))
    {:peg (then ['any (set-peg ranges)] (k :peg))}
    (and ranges (= :lazy mode))
    (do
      (def k* (share c k))
      {:peg (then ['any ['* ['not (k* :peg)] (set-peg ranges)]] (k* :peg))})
    (do
      (def name (rule c 0))
      (def loop-first (memo (fn [] (union (first-of node (fn [] {})) ((k :first))))))
      ; An iteration that matches nothing fails, as Oniguruma's empty check
      ; ends the loop, so that the loop cannot repeat forever. Its start is
      ; captured as a string, which scan ignores.
      (def mark (when (nullable? c node) (keyword "a" (length (c :rules)))))
      (def again {:peg (if mark
                         ['* ['drop ['cmt ['* ['backref mark] ['position]]
                                     (fn [start pos] (not= (scan-number start) pos))]]
                          name]
                         name)
                  :first loop-first})
      (def body (rule c (then (if mark ['cmt ['position] string mark] 0)
                              (compile-node c node again))))
      (def k* (share c k))
      (put! (c :rules) name (if (= :greedy mode)
                              ['+ body (k* :peg)]
                              ['+ (k* :peg) body]))
      {:peg name :body body})))

(defn- compile-rep [c [_ lo hi mode node] k]
  (if (= :possessive mode)
    (do
      (def body (compile-node c node eps))
      (then (cond
              (= [lo hi] [0 nil]) ['any body]
              (= [lo hi] [1 nil]) ['some body]
              (= [lo hi] [0 1]) ['opt body]
              (nil? hi) ['at-least lo body]
              ['between lo hi body])
            (k :peg)))
    (do
      ; The optional repetitions beyond the minimum, then the minimum.
      (var rest k)
      (var lo lo)
      (if (nil? hi)
        (do
          (def star (compile-star c node mode k))
          (def star-first (memo (fn [] (union (first-of node (fn [] {})) ((k :first))))))
          (if (and (star :body) (pos? lo))
            ; The rule for node followed by the repetition is one of the
            ; minimum repetitions.
            (do
              (set rest {:peg (star :body) :first (memo (fn [] (first-of node star-first)))})
              (-- lo))
            (set rest {:peg (star :peg) :first star-first})))
        (repeat (- hi lo)
          (def k* (share c rest))
          (def body (compile-node c node k*))
          (set rest {:peg (if (= :greedy mode)
                            ['+ body (k* :peg)]
                            ['+ (k* :peg) body])
                     :first (let [after (k* :first)]
                              (memo (fn [] (union (first-of node after) (after)))))})))
      (repeat lo
        (set rest (continue c node rest)))
      (rest :peg))))

(defn- collect
  "Puts the groups under node into groups, and the groups that are backreferenced into backrefs."
  [c node]
  (case (first node)
    :group (do
             (put! (c :groups) (get node 1) node)
             (collect c (get node 2)))
    :backref (put! (c :backrefs) (group-number c (get node 1)) true)
    :seq (each n (get node 1) (collect c n))
    :alt (each n (get node 1) (collect c n))
    :atomic (collect c (get node 1))
    :look (collect c (get node 3))
    :rep (collect c (get node 4))
    nil))

(defn- backref-behind
  "Returns the PEG that matches if the text before the position is what group n captured."
  [c n]
  ['drop ['cmt ['* ['position] ['backref (keyword "t" n)] ['argument 2]]
          (fn [pos captured text]
            (def len (length captured))
            (and (>= pos len) (= captured (string/slice text (- pos len) pos))))]])

(defn- search-behind
  """
  Returns the PEG that matches if node matches text that ends at the
  position, for a node that does not match a fixed number of bytes. Each
  possible start is tried, with a PEG of its own that must end at the
  position, which it takes as a fourth argument.
  """
  [c node]
  (def sub !{:rules !{} :names (c :names) :groups (c :groups) :backrefs !{}
             :calls !{} :depths !{} :visiting !{}})
  (collect sub node)
  (unless (empty? (sub :backrefs))
    (error "unsupported backreference in a lookbehind"))
  (def end ['drop ['cmt ['* ['position] ['argument 3]] =]])
  (put! (sub :rules) :main (compile-node sub node {:peg end :first (fn [] nil)}))
  (def peg (peg/compile (table/to-map (sub :rules))))
  ['drop ['cmt ['* ['position] ['argument 0] ['argument 1] ['argument 2]]
          (fn [pos g a text]
            (var start pos)
            (var found false)
            (while (and (not found) (>= start 0))
              (when (peg/match peg text start g a text pos)
                (set found true))
              (-- start))
            found)]])

(defn- compile-look [c [_ dir neg? node] k]
  (def test
    (if (= :ahead dir)
      (compile-node c node eps)
      (do
        (def parts ![])
        (each branch (if (= :alt (first node)) (get node 1) [node])
          (cond
            (= :backref (first branch))
            (array/push! parts (backref-behind c (group-number c (get branch 1))))
            (variants branch)
            (each v (variants branch)
              (array/push! parts ['look (- (fixed-length v)) (compile-node c v eps)]))
            (array/push! parts (search-behind c branch))))
        (if (= 1 (length parts)) (first parts) ['+ |parts]))))
  [(if neg? 'if-not 'if) test (k :peg)])

(defn- compile-group [c [_ n node] k]
  (def ref? (has-key? (c :backrefs) n))
  (def open ['* ['constant n] (if ref? ['position (keyword "s" n)] ['position])])
  (def close ['* ['constant (- n)] ['position]
              |(if ref?
                 [['cmt ['* ['backref (keyword "s" n)] ['position] ['argument 2]]
                   (fn [start end text] (string/slice text start end))
                   (keyword "t" n)]]
                 [])])
  (then open (compile-node c node {:peg (then close (k :peg)) :first (k :first)})))

; How deeply a group that calls itself is expanded.
(def- max-call-depth 10)

(defn- compile-call [c [_ ref] k]
  ; A call is compiled as a copy of the group, followed by k, so that a match
  ; can backtrack into it. A group that calls itself is copied to a limited
  ; depth, below which it is a rule that does not backtrack.
  (def n (group-number c ref))
  (def node (or (get (c :groups) n) (errorf "unknown group: %d" n)))
  (def depth (get (c :depths) n 0))
  (if (< depth max-call-depth)
    (do
      (put! (c :depths) n (inc depth))
      (def peg (compile-node c node k))
      (put! (c :depths) n depth)
      peg)
    (do
      (def name (or (get (c :calls) n)
                    (do
                      (def name (rule c 0))
                      (put! (c :calls) n name)
                      (put! (c :rules) name (compile-node c node eps))
                      name)))
      (then name (k :peg)))))

(set compile-node
  (fn [c node k]
    (case (first node)
      :lit (then (get node 1) (k :peg))
      :set (then (set-peg (get node 1)) (k :peg))
      :seq (do
             (var rest k)
             (each n (reverse (get node 1))
               (set rest (continue c n rest)))
             (rest :peg))
      :alt (do
             (def k* (share c k))
             ['+ |(map (fn [n] (compile-node c n k*)) (get node 1))])
      :group (compile-group c node k)
      :atomic (then (compile-node c (get node 1) eps) (k :peg))
      :look (compile-look c node k)
      :rep (compile-rep c node k)
      :backref (then ['backmatch (keyword "t" (group-number c (get node 1)))] (k :peg))
      :call (compile-call c node k)
      :assert (then (get assertions (get node 1)) (k :peg))
      (errorf "unknown node: %q" node))))

(defn- guard
  """
  Returns a PEG that matches nothing and fails unless the next byte is in the
  byte set s, or nil if s allows any byte.
  """
  [s]
  (when (and s (not= :accept s))
    (def bytes (string/from-bytes |(sort (filter #(< $ end-byte) (keys s)))))
    (def next-byte (if (empty? bytes) ['not 0] ['look 0 ['set bytes]]))
    (if (has-key? s end-byte)
      ['+ next-byte ['not 1]]
      next-byte)))

(defn compile
  """
  Compiles the regex source and returns a map of :grammar, the PEG grammar
  that matches it, :groups, its number of capture groups, and :guard, a PEG
  that fails where no match can start, or nil. Raises an error for syntax
  that is not supported.
  """
  [source]
  (def parsed (regex/parse source))
  (def c !{:rules !{} :names (parsed :names) :groups !{} :backrefs !{} :calls !{} :depths !{} :visiting !{}})
  (collect c (parsed :node))
  (def main (compile-node c (parsed :node) {:peg ['position] :first (fn [] :accept)}))
  (put! (c :rules) :main main)
  {:grammar (table/to-map (c :rules))
   :groups (parsed :groups)
   :guard (guard (first-of (parsed :node) (fn [] :accept)))})

(defn scanner
  """
  Returns a PEG that finds the earliest match of any of the compiled regexes
  in compiled, with the first winning a tie. Its captures are the index of
  the regex that matched, the start of the match and that regex's captures.
  """
  [compiled]
  (peg/compile
    ['thru ['+ |(map (fn [i]
                       (def c (get compiled i))
                       ; The guard rules out most candidates on their first byte.
                       ['* |(if (c :guard) [(c :guard)] [])
                        ['constant i] ['position] (c :grammar)])
                     (range (length compiled)))]]))

(defn scan
  """
  Finds the earliest match of the scanner in text, at or after pos. g is the
  position at which \\G matches and a the position at which \\A matches, or
  -1. Returns nil, or a vector of the index of the regex that matched and a
  table of capture group numbers to [start end] pairs, with 0 for the whole
  match.
  """
  [scanner text pos g a]
  (when-let [caps (peg/match scanner text pos g a text)]
    (def groups !{0 [(get caps 1) (last caps)]})
    (def opens !{})
    (var i 2)
    (def n (dec (length caps)))
    (while (< i n)
      (def m (get caps i))
      (if (string? m)
        (++ i)
        (do
          (def at (get caps (inc i)))
          ; A group that calls itself opens again before it closes.
          (if (pos? m)
            (do
              (unless (get opens m)
                (put! opens m ![]))
              (array/push! (get opens m) at))
            (put! groups (- m) [(array/pop! (get opens (- m))) at]))
          (+= i 2))))
    [(first caps) groups]))
