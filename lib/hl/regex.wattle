; A parser for the Oniguruma regular expressions in TextMate grammars.
;
; The syntax is Oniguruma's default (Ruby) syntax, with every group numbered,
; named or not, as vscode-oniguruma numbers them. A regex parses to an AST of
; vectors:
;
;   [:lit s]                   the bytes of s
;   [:set ranges]              a code point in one of ranges, a sorted vector
;                              of [lo hi] pairs
;   [:seq nodes]               nodes in turn
;   [:alt nodes]               the first of nodes that leads to a match
;   [:group n node]            capture group n
;   [:atomic node]             (?>...)
;   [:look dir neg? node]      a lookaround, with dir :ahead or :behind
;   [:rep min max mode node]   node repeated min to max times (max nil is no
;                              limit), with mode :greedy, :lazy or :possessive
;   [:backref n]               the text that group n captured
;   [:call n]                  group n's expression, as \g<...> calls it
;   [:assert kind]             kind is :bol, :eol, :word, :non-word, :G, :A,
;                              :z or :Z
;
; Unicode properties are approximated: every non-ASCII code point is a letter,
; a number, a mark and a word character.

(def max-cp 0x10FFFF)

; Code point ranges

(defn- merge-ranges
  "Returns ranges sorted, with overlapping and adjacent ranges merged."
  [ranges]
  (def out ![])
  (each [lo hi] (sort-by first ranges)
    (def prev (array/peek out))
    (if (and prev (<= lo (inc (get prev 1))))
      (put! out (dec (length out)) [(get prev 0) (max hi (get prev 1))])
      (array/push! out [lo hi])))
  (vec out))

(defn complement
  "Returns the code point ranges not in ranges, which must be merged."
  [ranges]
  (def out ![])
  (var next 0)
  (each [lo hi] ranges
    (when (< next lo)
      (array/push! out [next (dec lo)]))
    (set next (inc hi)))
  (when (<= next max-cp)
    (array/push! out [next max-cp]))
  (vec out))

(defn- byte-ranges [s]
  (map (fn [b] [b b]) (string/bytes s)))

(def- digit [[0x30 0x39]])
(def- non-ascii [[0x80 max-cp]])
(def- alpha [[0x41 0x5A] [0x61 0x7A]])
(def- word (merge-ranges [|digit |alpha [0x5F 0x5F] |non-ascii]))
(def- space (merge-ranges (byte-ranges " \t\n\r\f\v")))
(def- hex (merge-ranges [|digit [0x41 0x46] [0x61 0x66]]))

(def- properties
  "The ranges of the Unicode properties and POSIX classes, approximated."
  {"l" (merge-ranges [|alpha |non-ascii])
   "letter" (merge-ranges [|alpha |non-ascii])
   "alpha" (merge-ranges [|alpha |non-ascii])
   "n" (merge-ranges [|digit |non-ascii])
   "number" (merge-ranges [|digit |non-ascii])
   "nd" (merge-ranges [|digit |non-ascii])
   "m" non-ascii
   "mark" non-ascii
   "alnum" (merge-ranges [|digit |alpha |non-ascii])
   "word" word
   "digit" digit
   "xdigit" hex
   "space" space
   "blank" (byte-ranges " \t")
   "upper" [[0x41 0x5A]]
   "lower" [[0x61 0x7A]]
   "punct" (merge-ranges (byte-ranges "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"))
   "cntrl" [[0 0x1F] [0x7F 0x7F]]
   "print" [[0x20 0x7E] |non-ascii]
   "graph" [[0x21 0x7E] |non-ascii]
   "ascii" [[0 0x7F]]
   "any" [[0 max-cp]]})

; UTF-8

(defn utf8
  "Returns the UTF-8 encoding of the code point cp."
  [cp]
  (cond
    (< cp 0x80) (string/from-bytes cp)
    (< cp 0x800) (string/from-bytes (bor 0xC0 (brshift cp 6))
                                    (bor 0x80 (band cp 0x3F)))
    (< cp 0x10000) (string/from-bytes (bor 0xE0 (brshift cp 12))
                                      (bor 0x80 (band (brshift cp 6) 0x3F))
                                      (bor 0x80 (band cp 0x3F)))
    (string/from-bytes (bor 0xF0 (brshift cp 18))
                       (bor 0x80 (band (brshift cp 12) 0x3F))
                       (bor 0x80 (band (brshift cp 6) 0x3F))
                       (bor 0x80 (band cp 0x3F)))))

(defn- decode-at
  "Returns the code point at byte i of s and the index after it."
  [s i]
  (def b (get s i))
  (def n (cond (< b 0x80) 1 (< b 0xE0) 2 (< b 0xF0) 3 4))
  (if (= n 1)
    [b (inc i)]
    (do
      (var cp (band b (case n 2 0x1F 3 0x0F 0x07)))
      (for j 1 n
        (set cp (bor (blshift cp 6) (band (get s (+ i j) 0) 0x3F))))
      [cp (+ i n)])))

; The parser

(defn- fail [p msg & args]
  (errorf "%s at offset %d in regex" (string/format msg |args) (p :pos)))

(defn- peek-at [p offset]
  (get (p :src) (+ (p :pos) offset)))

(defn- peek [p]
  (peek-at p 0))

(defn- advance-by [p n]
  (put! p :pos (+ (p :pos) n)))

(defn- advance [p]
  (advance-by p 1))

(defn- at? [p s]
  (def src (p :src))
  (def pos (p :pos))
  (= s (string/slice src pos (min (length src) (+ pos (length s))))))

(defn- eat [p s]
  (when (at? p s)
    (advance-by p (length s))
    true))

(defn- expect [p s]
  (unless (eat p s)
    (fail p "expected `%s`" s)))

(defn- read-while
  "Returns the bytes from the current position for which pred is true."
  [p pred]
  (def start (p :pos))
  (while (and (peek p) (pred (peek p)))
    (advance p))
  (string/slice (p :src) start (p :pos)))

(defn- hex-digit? [b]
  (or (<= (chr "0") b (chr "9"))
      (<= (chr "a") b (chr "f"))
      (<= (chr "A") b (chr "F"))))

(defn- digit? [b]
  (<= (chr "0") b (chr "9")))

(defn- name-char? [b]
  (not (or (= b (chr ">")) (= b (chr "'")))))

(defn- read-hex [p max-digits]
  (def start (p :pos))
  (while (and (< (- (p :pos) start) max-digits) (peek p) (hex-digit? (peek p)))
    (advance p))
  (when (= start (p :pos))
    (fail p "expected a hex digit"))
  (scan-number (string/slice (p :src) start (p :pos)) 16))

(defn- read-name
  "Reads the name in <name> or 'name' and returns it."
  [p]
  (def close (cond (eat p "<") ">" (eat p "'") "'" (fail p "expected a group name")))
  (def name (read-while p name-char?))
  (expect p close)
  name)

(defn- skip-extended
  "Skips whitespace and comments when the extended flag is set."
  [p]
  (when (p :extended?)
    (var more true)
    (while more
      (def b (peek p))
      (cond
        (nil? b) (set more false)
        (has-value? [(chr " ") (chr "\t") (chr "\n") (chr "\r") (chr "\f") (chr "\v")] b) (advance p)
        (= b (chr "#")) (while (and (peek p) (not= (peek p) (chr "\n"))) (advance p))
        (set more false)))))

(defn- property
  "Reads the name of a property after \\p and returns its ranges."
  [p negated?]
  (expect p "{")
  (def neg? (if (eat p "^") (not negated?) negated?))
  (def raw (read-while p #(not= $ (chr "}"))))
  (expect p "}")
  (def key (string/ascii-lower (string/replace-all "_" "" (string/replace-all " " "" raw))))
  (def ranges (or (get properties key) (fail p "unsupported property: %s" raw)))
  (if neg? (complement ranges) ranges))

(defn- class-escape
  """
  Reads an escape after the backslash that stands for a set of code points,
  and returns its ranges, or nil if it is not one.
  """
  [p]
  (def b (peek p))
  (def ranges
    (case b
      (chr "d") digit
      (chr "D") (complement digit)
      (chr "w") word
      (chr "W") (complement word)
      (chr "s") space
      (chr "S") (complement space)
      (chr "h") hex
      (chr "H") (complement hex)
      nil))
  (cond
    ranges (do (advance p) ranges)
    (= b (chr "p")) (do (advance p) (property p false))
    (= b (chr "P")) (do (advance p) (property p true))
    nil))

(defn- char-escape
  "Reads an escape after the backslash that stands for one code point."
  [p in-class?]
  (def b (peek p))
  (when (nil? b)
    (fail p "trailing backslash"))
  (advance p)
  (case b
    (chr "n") 0x0A
    (chr "t") 0x09
    (chr "r") 0x0D
    (chr "f") 0x0C
    (chr "v") 0x0B
    (chr "a") 0x07
    (chr "e") 0x1B
    (chr "b") (if in-class? 0x08 (fail p "unexpected \\b"))
    (chr "x") (if (eat p "{")
                (do
                  (def cp (read-hex p 8))
                  (expect p "}")
                  cp)
                (read-hex p 2))
    (chr "u") (read-hex p 4)
    (chr "0") (do
                (def digits (read-while p #(<= (chr "0") $ (chr "7"))))
                (if (empty? digits) 0 (scan-number digits 8)))
    (do
      (when (or (<= (chr "a") b (chr "z")) (<= (chr "A") b (chr "Z")) (digit? b))
        (advance-by p -1)
        (fail p "unsupported escape: \\%s" (string/from-bytes b)))
      ; A non-ASCII escaped character is the whole of its encoding.
      (if (< b 0x80)
        b
        (do
          (def [cp next] (decode-at (p :src) (dec (p :pos))))
          (put! p :pos next)
          cp)))))

(defn- literal-cp
  "Reads one literal code point."
  [p]
  (def [cp next] (decode-at (p :src) (p :pos)))
  (put! p :pos next)
  cp)

; Case folding, for (?i), of ASCII letters only

(defn- fold-ranges
  "Returns ranges with the other case of each ASCII letter in them added."
  [ranges]
  (def out (array/slice ranges))
  (each [lo hi] ranges
    (each [a b shift] [[0x41 0x5A 0x20] [0x61 0x7A -0x20]]
      (when (and (<= lo b) (>= hi a))
        (array/push! out [(+ (max lo a) shift) (+ (min hi b) shift)]))))
  out)

(defn- fold-lit
  "Returns the node for the literal s matched without regard to case."
  [s]
  (def nodes ![])
  (var start 0)
  (for i 0 (length s)
    (def b (get s i))
    (def other (cond
                 (<= 0x41 b 0x5A) (+ b 0x20)
                 (<= 0x61 b 0x7A) (- b 0x20)))
    (when other
      (when (< start i)
        (array/push! nodes [:lit (string/slice s start i)]))
      (array/push! nodes [:set (merge-ranges [[b b] [other other]])])
      (set start (inc i))))
  (when (< start (length s))
    (array/push! nodes [:lit (string/slice s start)]))
  (if (= 1 (length nodes)) (first nodes) [:seq (vec nodes)]))

(var- parse-class nil)

(defn- class-item
  "Reads one item of a class and returns its ranges and, for a single code point, the code point."
  [p]
  (cond
    (at? p "[:")
    (do
      (def start (p :pos))
      (advance-by p 2)
      (def neg? (eat p "^"))
      (def name (read-while p #(<= (chr "a") $ (chr "z"))))
      (if (eat p ":]")
        (do
          (def ranges (or (get properties name) (fail p "unsupported POSIX class: %s" name)))
          [(if neg? (complement ranges) ranges) nil])
        (do
          ; Not a POSIX class, so a nested class.
          (put! p :pos start)
          [(parse-class p) nil])))
    (= (peek p) (chr "["))
    [(parse-class p) nil]
    (= (peek p) (chr "\\"))
    (do
      (advance p)
      (if-let [ranges (class-escape p)]
        [ranges nil]
        (do
          (def cp (char-escape p true))
          [[[cp cp]] cp])))
    (do
      (def cp (literal-cp p))
      [[[cp cp]] cp])))

(set parse-class
  (fn [p]
    (expect p "[")
    (def negated? (eat p "^"))
    (def ranges ![])
    (var first? true)
    (while (or first? (not= (peek p) (chr "]")))
      (when (nil? (peek p))
        (fail p "unterminated class"))
      (when (at? p "&&")
        (fail p "unsupported class intersection"))
      (def [item cp] (if (and first? (= (peek p) (chr "]")))
                       (do (advance p) [[[0x5D 0x5D]] 0x5D])
                       (class-item p)))
      (set first? false)
      (if (and cp (= (peek p) (chr "-")) (not= (peek-at p 1) (chr "]")) (peek-at p 1))
        (do
          (advance p)
          (def [hi-ranges hi] (class-item p))
          (unless hi
            (fail p "invalid class range"))
          (when (< hi cp)
            (fail p "empty class range"))
          (array/push! ranges [cp hi]))
        (array/push! ranges |item)))
    (expect p "]")
    (def merged (merge-ranges (if (p :ignore-case?) (fold-ranges ranges) ranges)))
    (if negated? (complement merged) merged)))

(var- parse-alt nil)

(defn- group
  "Reads a group after its opening parenthesis."
  [p]
  (defn body []
    (def node (parse-alt p))
    (expect p ")")
    node)
  (defn capture [name]
    (def n (inc (p :groups)))
    (put! p :groups n)
    (when name
      (put! (p :names) name n))
    (def node (body))
    [:group n node])
  (cond
    (eat p "?:") (body)
    (eat p "?>") [:atomic (body)]
    (eat p "?=") [:look :ahead false (body)]
    (eat p "?!") [:look :ahead true (body)]
    (eat p "?<=") [:look :behind false (body)]
    (eat p "?<!") [:look :behind true (body)]
    (eat p "?#") (do
                   (while (and (peek p) (not= (peek p) (chr ")")))
                     (advance p))
                   (expect p ")")
                   [:seq []])
    (or (at? p "?<") (at? p "?'"))
    (do
      (advance p)
      (capture (read-name p)))
    (at? p "?P<")
    (do
      (advance-by p 2)
      (capture (read-name p)))
    (eat p "?")
    (do
      ; Options: (?ix), (?i-x), (?-i), (?ix:...)
      (defn flags []
        (read-while p #(has-value? [(chr "i") (chr "m") (chr "x")] $)))
      (def on (flags))
      (def off (if (eat p "-") (flags) ""))
      (when (string/find "m" (string on off))
        (fail p "unsupported option: m"))
      (when (empty? (string on off))
        (fail p "unsupported group"))
      (def saved [(p :extended?) (p :ignore-case?)])
      (defn set-options []
        (each [flag key] [["x" :extended?] ["i" :ignore-case?]]
          (cond
            (string/find flag on) (put! p key true)
            (string/find flag off) (put! p key false))))
      (cond
        (eat p ")")
        (do
          ; The options apply to the rest of the enclosing group.
          (set-options)
          (parse-alt p))
        (eat p ":")
        (do
          (set-options)
          (def node (body))
          (put! p :extended? (get saved 0))
          (put! p :ignore-case? (get saved 1))
          node)
        (fail p "unsupported group")))
    (capture nil)))

(defn- interval
  """
  Reads an interval quantifier, {n}, {n,}, {,m} or {n,m}, and returns its
  minimum and maximum, or nil, leaving the position unchanged, if there is
  none.
  """
  [p]
  (def src (p :src))
  (def m (peg/match '(* "{" (<- (any (range "09"))) (<- (? ",")) (<- (any (range "09"))) "}" (position))
                    src (p :pos)))
  (when m
    (def [lo comma hi end] m)
    (unless (and (empty? lo) (empty? hi))
      (put! p :pos end)
      (def min-n (if (empty? lo) 0 (scan-number lo)))
      (def max-n (cond (empty? comma) min-n (empty? hi) nil (scan-number hi)))
      [min-n max-n (and (empty? comma) true)])))

(defn- quantify
  "Applies the quantifiers that follow node."
  [p node]
  (var out node)
  (var more true)
  (while more
    (skip-extended p)
    (def b (peek p))
    (def q (cond
             (= b (chr "*")) (do (advance p) [0 nil false])
             (= b (chr "+")) (do (advance p) [1 nil false])
             (= b (chr "?")) (do (advance p) [0 1 false])
             (= b (chr "{")) (interval p)
             nil))
    (if (nil? q)
      (set more false)
      (do
        (def [lo hi exact?] q)
        (def mode (cond
                    ; In Ruby syntax, an interval is never possessive, and
                    ; {n}? is {n} made optional.
                    (= b (chr "{")) (if (and (not exact?) (eat p "?")) :lazy :greedy)
                    (eat p "?") :lazy
                    (eat p "+") :possessive
                    :greedy))
        (set out [:rep lo hi mode out])))
    (when (and (= (first out) :rep) (= :assert (first (get out 4))))
      (fail p "quantified assertion")))
  out)

(defn- escape
  "Reads an escape outside a class, after the backslash."
  [p]
  (def b (peek p))
  (cond
    (nil? b) (fail p "trailing backslash")
    (= b (chr "b")) (do (advance p) [:assert :word])
    (= b (chr "B")) (do (advance p) [:assert :non-word])
    (= b (chr "A")) (do (advance p) [:assert :A])
    (= b (chr "G")) (do (advance p) [:assert :G])
    (= b (chr "z")) (do (advance p) [:assert :z])
    (= b (chr "Z")) (do (advance p) [:assert :Z])
    (= b (chr "k")) (do
                      (advance p)
                      (def name (read-name p))
                      [:backref (or (scan-number name) name)])
    (= b (chr "g")) (do
                      (advance p)
                      (def name (read-name p))
                      ; A signed number is relative to the groups opened so far.
                      (def n (scan-number name))
                      (def sign (get name 0))
                      [:call (cond
                               (nil? n) name
                               (= sign (chr "-")) (+ (p :groups) 1 n)
                               (= sign (chr "+")) (+ (p :groups) n)
                               n)])
    (and (<= (chr "1") b (chr "9")))
    (do
      (def digits (read-while p digit?))
      [:backref (scan-number digits)])
    (= b (chr "Q")) (do
                      (advance p)
                      (def start (p :pos))
                      (def end (or (string/find "\\E" (p :src) start) (length (p :src))))
                      (put! p :pos (min (length (p :src)) (+ end 2)))
                      [:lit (string/slice (p :src) start end)])
    (if-let [ranges (class-escape p)]
      [:set ranges]
      [:lit (utf8 (char-escape p false))])))

(defn- atom
  "Reads one atom, or returns nil at the end of a sequence."
  [p]
  (skip-extended p)
  (def b (peek p))
  (cond
    (or (nil? b) (= b (chr "|")) (= b (chr ")"))) nil
    (= b (chr "(")) (do (advance p) (group p))
    (= b (chr "[")) [:set (parse-class p)]
    (= b (chr ".")) (do (advance p) [:set (complement [[0x0A 0x0A]])])
    (= b (chr "^")) (do (advance p) [:assert :bol])
    (= b (chr "$")) (do (advance p) [:assert :eol])
    (= b (chr "\\")) (do (advance p) (escape p))
    (or (= b (chr "*")) (= b (chr "+")) (= b (chr "?"))) (fail p "nothing to repeat")
    (do
      (def start (p :pos))
      (literal-cp p)
      [:lit (string/slice (p :src) start (p :pos))])))

(defn- fold-atom
  "Returns node, the literal that atom read, without regard to case if the option is set."
  [p node]
  (if (and node (p :ignore-case?) (= :lit (first node)))
    (fold-lit (get node 1))
    node))

(defn- parse-seq [p]
  (def nodes ![])
  (var node (fold-atom p (atom p)))
  (while node
    (def q (quantify p node))
    ; Adjacent literals are joined.
    (def prev (array/peek nodes))
    (if (and prev (= :lit (first prev)) (= :lit (first q)))
      (put! nodes (dec (length nodes)) [:lit (string (get prev 1) (get q 1))])
      (array/push! nodes q))
    (set node (fold-atom p (atom p))))
  (if (= 1 (length nodes)) (first nodes) [:seq (vec nodes)]))

(set parse-alt
  (fn [p]
    (def saved [(p :extended?) (p :ignore-case?)])
    (def branches ![(parse-seq p)])
    (while (eat p "|")
      (array/push! branches (parse-seq p)))
    ; An option set inside a group ends with it.
    (put! p :extended? (get saved 0))
    (put! p :ignore-case? (get saved 1))
    (if (= 1 (length branches)) (first branches) [:alt (vec branches)])))

(defn parse
  """
  Parses the regex source and returns a map of :node, its AST, :groups, the
  number of capture groups, and :names, a map of group names to numbers.
  Raises an error for syntax it does not support.
  """
  [source]
  (def p !{:src source :pos 0 :groups 0 :names !{} :extended? false :ignore-case? false})
  (def node (parse-alt p))
  (when (peek p)
    (fail p "unmatched `)`"))
  {:node node :groups (p :groups) :names (table/to-map (p :names))})
